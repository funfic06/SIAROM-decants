# Configure these in Vercel Project Settings → Environment Variables.
CAJUPAY_API_KEY=
CAJUPAY_API_SECRET=

# Interpretação de pedidos do WhatsApp com IA (opcional).
# Crie a chave em console.anthropic.com → API Keys. Sem ela, o painel usa só as regras gratuitas.
ANTHROPIC_API_KEY=
# Opcional: troque o modelo sem mexer no código (padrão: claude-haiku-5-5).
ANTHROPIC_MODEL=
